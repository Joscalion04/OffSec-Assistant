# OffSec Assistant — Variables de entorno
# Copiar este archivo a .env y completar los valores
# NUNCA commitear el .env real al repositorio

# ── REQUERIDA ─────────────────────────────────────────────────────────────────
# API key de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZAR

# ── VPN (opcional) ────────────────────────────────────────────────────────────
# Poner en "true" para activar VPN al iniciar el contenedor
# Copiar el archivo .ovpn o .conf a docker/vpn/ antes de ejecutar
USE_VPN=false

# Directorio con configuración VPN (cambiar si tus configs están en otro lado)
# VPN_CONFIG_DIR=./docker/vpn

# ── Zona horaria ─────────────────────────────────────────────────────────────
TZ=UTC
